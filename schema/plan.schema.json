{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://学业罗盘/schema/plan.schema.json",
  "title": "PlanFile — 培养方案结构化结果（M1 产物，golden 数据）",
  "type": "object",
  "required": ["meta", "modules", "courses"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["major", "grade", "source_doc", "total_credits", "verified"],
      "properties": {
        "major": { "type": "string", "enum": ["computer_science", "software_engineering"] },
        "grade": { "type": "string", "pattern": "^20\\d{2}$" },
        "source_doc": { "type": "string" },
        "total_credits": { "type": "number", "exclusiveMinimum": 0 },
        "extracted_by": { "type": "string" },
        "verified": { "type": "boolean" },
        "verified_at": { "type": "string" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module_id", "module_path", "required_credits"],
        "properties": {
          "module_id": { "type": "string", "pattern": "^[a-z_]+$" },
          "module_path": { "type": "string" },
          "required_credits": { "type": "number", "minimum": 0 },
          "course_ids": { "type": "array", "items": { "type": "string" } },
          "n_select": {
            "type": "integer",
            "minimum": 1,
            "description": "选课组：组内课程任选 N 门即满足（audit 据此把要求学分按 N 门折算，不再全组和）"
          },
          "group": {
            "type": "object",
            "description": "选课组显式结构：{min_courses, min_credits} 任一非空即按组核算",
            "properties": {
              "min_courses": { "type": "integer", "minimum": 1 },
              "min_credits": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "choice_rule": {
            "type": "object",
            "description": "板块说明识别出的修读选择约束（plan_audit_adapter 产物）：{text, min_credits, min_courses, pick_from}",
            "properties": {
              "text": { "type": "string" },
              "min_credits": { "type": ["number", "null"] },
              "min_courses": { "type": ["integer", "null"], "minimum": 1 },
              "pick_from": { "type": ["integer", "null"], "minimum": 2 }
            }
          },
          "count_rule": {
            "type": "boolean",
            "description": "为 true 时 required_credits 的数字是「要求门数」不是学分；audit 按 N 门最便宜课程折算，绝不把门数当学分"
          },
          "plan_credits_unit": {
            "enum": ["学分", "门"],
            "description": "板块标注学分数量单位（'门' 同 count_rule 语义）"
          }
        }
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["course_id", "name", "credits", "module_id", "nature", "offered", "prereq", "source"],
        "properties": {
          "course_id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "credits": { "type": "number", "exclusiveMinimum": 0, "maximum": 20, "multipleOf": 0.5 },
          "module_id": { "type": "string" },
          "nature": { "enum": ["通识必修", "必修", "限选", "任选", "实践"] },
          "offered": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["秋", "春"] },
            "description": "仅秋季=[\"秋\"]，仅春季=[\"春\"]，两学期=[\"秋\",\"春\"]；隔年开课在 plan 数据里以 grade_cycle 字段标记"
          },
          "grade_cycle": { "type": ["integer", "null"], "minimum": 1, "description": "隔年开课的周期，如 2=两年一轮；缺省 null 表示每年开" },
          "prereq": { "type": "array", "items": { "type": "string" } },
          "source": {
            "type": "object",
            "required": ["page"],
            "properties": { "page": { "type": ["integer", "null"], "minimum": 1 } }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
